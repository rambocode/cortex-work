node_modules/
dist/
out/
.next/
.turbo/
*.tsbuildinfo
*.log
.DS_Store
.env
.env.local
coverage/
.worktrees

# pi 的 bun 编译产物(二进制 + 旁置资产),由 apps/desktop/scripts/build-pi-binary.mjs 生成
apps/desktop/resources/pi/
# pi 编译产物缓存(按 pi版本-bun目标-bun版本 分目录),同上脚本生成,命中免重编
apps/desktop/.pi-build-cache/

# Cortex_Helper 的 swift 编译产物,由 apps/desktop/scripts/build-cortex-helper.mjs 生成
apps/desktop/resources/Cortex_Helper/

# agent-browser 目标平台二进制，由 prepare-agent-browser.mjs 从固定版本 npm 包生成
apps/desktop/resources/agent-browser/

# Cortex_Helper Swift 包的 SwiftPM 构建缓存
apps/desktop/native/Cortex_Helper/.build/

# Compound Engineering 本地配置
.compound-engineering/*.local.yaml

# bento slides 运行时空壳,由 apps/desktop/scripts/sync-bento-runtime.mjs 从 vendor/bento 构建产物同步
apps/desktop/resources/slides/bento/

# dev 模式下内置 skill(合同审查/故障致歉等)的运行时报告产物
apps/desktop/outputs/

# whisper 运行时(平台二进制 + 模型),由 apps/desktop/scripts/prepare-whisper-runner.mjs 生成
apps/desktop/resources/whisper/

# 发版前手工备份的 dist 快照(dist.bak-<时间戳>/,内含整个 .app,单份可达 GB 级)。
# 根规则的 `dist/` 匹配不到带后缀的目录名,不显式忽略会被 eslint 扫进去、把 lint 结果刷成上千条
# vendor JS 报错,也有整包误提交的风险。
apps/desktop/dist.bak-*/

# 发布控制台的产物暂存目录与流程状态(scripts/release-ui)，跨进程持久化用,不入库
.release-stage/
