{
  "name": "cortex-work",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "turbo dev --filter=@cortex-work/web",
    "dev:desktop": "turbo dev --filter=@cortex-work/desktop",
    "build": "turbo build",
    "build:web": "turbo build --filter=@cortex-work/web",
    "build:desktop": "turbo build --filter=@cortex-work/desktop",
    "start:web": "pnpm --filter @cortex-work/web start",
    "preview:desktop": "pnpm --filter @cortex-work/desktop preview",
    "dist": "pnpm dist:desktop",
    "dist:desktop": "pnpm --filter @cortex-work/desktop dist",
    "dist:desktop:dir": "pnpm --filter @cortex-work/desktop dist:dir",
    "dist:desktop:zip": "pnpm --filter @cortex-work/desktop dist:zip",
    "dist:desktop:dmg": "pnpm --filter @cortex-work/desktop dist:dmg",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "i18n:extract": "i18next-cli extract",
    "i18n:status": "i18next-cli status",
    "i18n:types": "i18next-cli types",
    "clean": "turbo clean && rm -rf node_modules",
    "release:ui": "node scripts/release-ui/server.mjs"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "supportedArchitectures": {
      "os": ["current", "darwin"],
      "cpu": ["current", "x64", "arm64"]
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "node-pty",
      "node-mac-permissions"
    ],
    "overrides": {
      "@earendil-works/pi-agent-core": "file:/Users/mike/source/ai/cortex-org/pi-local/.cortex-packages/earendil-works-pi-agent-core-0.84.3-cortex-local.0.tgz",
      "@earendil-works/pi-ai": "file:/Users/mike/source/ai/cortex-org/pi-local/.cortex-packages/earendil-works-pi-ai-0.84.3-cortex-local.0.tgz",
      "@earendil-works/pi-client": "file:/Users/mike/source/ai/cortex-org/pi-local/.cortex-packages/earendil-works-pi-client-0.84.3-cortex-local.0.tgz",
      "@earendil-works/pi-protocol": "file:/Users/mike/source/ai/cortex-org/pi-local/.cortex-packages/earendil-works-pi-protocol-0.84.3-cortex-local.0.tgz",
      "@earendil-works/pi-server": "file:/Users/mike/source/ai/cortex-org/pi-local/.cortex-packages/earendil-works-pi-server-0.84.3-cortex-local.0.tgz",
      "@earendil-works/pi-telemetry": "file:/Users/mike/source/ai/cortex-org/pi-local/.cortex-packages/earendil-works-pi-telemetry-0.84.3-cortex-local.0.tgz",
      "@earendil-works/pi-tui": "file:/Users/mike/source/ai/cortex-org/pi-local/.cortex-packages/earendil-works-pi-tui-0.84.3-cortex-local.0.tgz",
      "@types/react": "catalog:",
      "@types/react-dom": "catalog:",
      "minimatch": "10.2.5",
      "sherpa-onnx-darwin-arm64": "1.12.40",
      "sherpa-onnx-darwin-x64": "1.12.40",
      "sherpa-onnx-win-x64": "1.12.40"
    }
  },
  "devDependencies": {
    "i18next-cli": "^1.64.1",
    "turbo": "^2.5.4",
    "typescript": "catalog:"
  }
}
