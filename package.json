{
  "name": "cortex-work",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "turbo dev --filter=@cortex-work/web",
    "dev:desktop": "turbo dev --filter=@cortex-work/desktop",
    "build": "turbo build",
    "build:web": "turbo build --filter=@cortex-work/web",
    "build:desktop": "turbo build --filter=@cortex-work/desktop",
    "start:web": "pnpm --filter @cortex-work/web start",
    "preview:desktop": "pnpm --filter @cortex-work/desktop preview",
    "dist": "pnpm dist:desktop",
    "dist:desktop": "pnpm --filter @cortex-work/desktop dist",
    "dist:desktop:dir": "pnpm --filter @cortex-work/desktop dist:dir",
    "dist:desktop:zip": "pnpm --filter @cortex-work/desktop dist:zip",
    "dist:desktop:dmg": "pnpm --filter @cortex-work/desktop dist:dmg",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "node-pty"
    ],
    "overrides": {
      "@types/react": "catalog:",
      "@types/react-dom": "catalog:",
      "minimatch": "10.2.5"
    }
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "catalog:"
  }
}
